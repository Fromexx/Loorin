generator client {
  provider = "prisma-client-js"
  output   = "./generated/providerClient"
}

datasource db {
  provider  = "postgresql"
  url = env("POSTGRES_PRISMA_PROVIDERS_URL")
  directUrl = env("POSTGRES_PROVIDERS_URL_NO_SSL")
}

model Provider {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique

  @@map("providers")
}
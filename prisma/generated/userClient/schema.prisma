generator client {
  provider = "prisma-client-js"
  output   = "./generated/userClient"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_USERS_URL")
  directUrl = env("POSTGRES_USERS_URL_NO_SSL")
}

model User {
  id             String  @id @default(cuid())
  name           String?
  email          String  @unique
  hashedPassword String

  @@map("users")
}
